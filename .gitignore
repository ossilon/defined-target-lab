# Keep all data out of the repository (data/tmp_chain_reply.json, the capture's inbox, included): TradingView licenses its data for display only, and Roundhill's site terms
# forbid redistributing or storing its files without written permission. data/README.md names each file's source.
data/*
!data/README.md

# Private working documents (the author's planning notes and AI build prompt hold personal context) and the private
# list of personal terms that scripts/scan_identifiers.py looks for. The repository never includes them.
PLAN.md
PROMPT.md
BACKLOG.md
B20_FABLE_REVIEW.md
V02_DESIGN.md
V02_MOCKUP.html
V03_DEPTH_PASS.md
V031_DEPTH_PASS.md
V031_RESEARCH_MEMO.md
V03_DESIGN.md
AUDIT_B10D_REVIEW.md
ASTRA_V030_AUDIT_PROMPT.md
AUDIT_V030_ASTRA_REVIEW.md
docs/README_DRAFT.md
forward/hypotheses_draft.json
forward/P3_draft.md
forward/FC1_draft.md
forward/H20_H21_draft.md
forward/hypotheses_draft_v1.json
identifiers_local.txt

# Daily forward-test notes hold issuer-derived daily numbers; publishing them needs Roundhill's permission.
forward/daily/

# Raw per-run outputs (someone could reverse daily series into prices); the project publishes aggregates only.
results/raw/

# Local cross-checks import private sibling folders outside this repository.
tests/*_local.py

# Python and numba caches, build output, virtual environments, local secrets
__pycache__/
*.pyc
*.nbi
*.nbc
*.egg-info/
build/
dist/
.venv/
.pytest_cache/
.env
V033_POLISH_PLAN.md
